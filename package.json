{
  "name": "draw-eer-monorepo",
  "private": true,
  "description": "Write ER/EER diagrams as text and see them rendered in classic Chen notation.",
  "license": "MIT",
  "author": "AmirMohammad Nasiri",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmirMOHNasiri/Draw-EER.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "vitest run --update",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render": "tsx packages/core/scripts/render.ts",
    "gallery": "tsx packages/core/scripts/render.ts examples/company.eer examples/library.eer examples/university.eer examples/vehicles.eer --png-only --scale 1.5 --out-dir docs/images",
    "bench": "tsx packages/core/scripts/bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
