{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EER Diagram",
  "scopeName": "source.eer",
  "comment": "Grammar for .eer files. Keywords like total, key or partial are only keywords where the language expects them, so they stay plain names elsewhere (an attribute can be called total). A quoted name gets the same scope as a bare one in the same place, inside string.quoted.double, so both have the same color. Written by hand; see docs/language.md.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#relationship"
    },
    {
      "include": "#specialize"
    },
    {
      "include": "#category"
    },
    {
      "include": "#partof"
    },
    {
      "include": "#aggregate"
    },
    {
      "include": "#show"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.eer",
          "match": "//.*$"
        },
        {
          "name": "comment.block.eer",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "entity-name": {
      "comment": "An entity (or aggregate) name, bare or quoted.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer entity.name.type.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "entity.name.type.eer"
        }
      ]
    },
    "relationship-name": {
      "comment": "A relationship name, bare or quoted.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer entity.name.function.relationship.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "entity.name.function.relationship.eer"
        }
      ]
    },
    "property-name": {
      "comment": "An attribute name, bare or quoted.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer variable.other.property.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "variable.other.property.eer"
        }
      ]
    },
    "role-name": {
      "comment": "A role name after `as` in a relationship.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer variable.parameter.role.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "variable.parameter.role.eer"
        }
      ]
    },
    "inherited-name": {
      "comment": "A supertype after `inherits`.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer entity.other.inherited-class.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "entity.other.inherited-class.eer"
        }
      ]
    },
    "label-name": {
      "comment": "The label of a part-of hexagon after `as`.",
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "name": "string.quoted.double.eer"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*",
          "name": "string.unquoted.label.eer"
        }
      ]
    },
    "entity": {
      "begin": "\\b(?:(weak)\\s+)?(entity)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.eer"
        },
        "2": {
          "name": "storage.type.entity.eer"
        },
        "3": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(inherits)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.inherits.eer"
            }
          }
        },
        {
          "include": "#attribute-block"
        },
        {
          "match": "(?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\")",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#inherited-name"
                }
              ]
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.eer"
        }
      ]
    },
    "attribute-block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.eer"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.eer"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#flags"
        },
        {
          "include": "#attribute-block"
        },
        {
          "match": "[(),]",
          "name": "punctuation.separator.eer"
        },
        {
          "match": "(?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\")",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#property-name"
                }
              ]
            }
          }
        }
      ]
    },
    "flags": {
      "begin": ":",
      "end": "(?=[{},\\n/])|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.key-value.eer"
        }
      },
      "patterns": [
        {
          "match": "\\b(?:key2|key|partial|multi|derived)\\b",
          "name": "storage.modifier.flag.eer"
        }
      ]
    },
    "relationship": {
      "begin": "\\b(?:(identifying)\\s+)?(rel)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.eer"
        },
        "2": {
          "name": "storage.type.relationship.eer"
        },
        "3": {
          "patterns": [
            {
              "include": "#relationship-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#participants"
        }
      ]
    },
    "participants": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.eer"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.eer"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#attrs"
        },
        {
          "include": "#participant"
        },
        {
          "match": ",",
          "name": "punctuation.separator.eer"
        }
      ]
    },
    "attrs": {
      "begin": "\\b(attrs)\\s*(?=\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.attrs.eer"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#attribute-block"
        }
      ]
    },
    "participant": {
      "comment": "One participant: the entity name first, then cardinality, participation and role in any order. It ends at a comma, the closing brace or the end of the line, so the next name always starts a new participant, wherever it is.",
      "begin": "((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?=[,}])|$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(as)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
          "captures": {
            "1": {
              "name": "keyword.other.as.eer"
            },
            "2": {
              "patterns": [
                {
                  "include": "#role-name"
                }
              ]
            }
          }
        },
        {
          "match": "\\b(?:total|partial)\\b",
          "name": "storage.modifier.participation.eer"
        },
        {
          "match": "\\(\\s*[^(),\\s]+\\s*,\\s*[^(),\\s]+\\s*\\)",
          "name": "constant.numeric.cardinality.eer"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:\\p{N}+|\\p{L}|\\*)(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.cardinality.eer"
        }
      ]
    },
    "names-block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.eer"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.eer"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": ",",
          "name": "punctuation.separator.eer"
        },
        {
          "match": "(?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\")",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#entity-name"
                }
              ]
            }
          }
        }
      ]
    },
    "specialize": {
      "begin": "\\b(specialize)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.specialize.eer"
        },
        "2": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(?:disjoint|overlapping|total|partial)\\b",
          "name": "storage.modifier.eer"
        },
        {
          "include": "#names-block"
        }
      ]
    },
    "category": {
      "begin": "\\b(category)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.category.eer"
        },
        "2": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(?:total|partial)\\b",
          "name": "storage.modifier.eer"
        },
        {
          "include": "#names-block"
        }
      ]
    },
    "partof": {
      "begin": "\\b(partof)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.partof.eer"
        },
        "2": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(as)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
          "captures": {
            "1": {
              "name": "keyword.other.as.eer"
            },
            "2": {
              "patterns": [
                {
                  "include": "#label-name"
                }
              ]
            }
          }
        },
        {
          "include": "#names-block"
        }
      ]
    },
    "aggregate": {
      "begin": "\\b(aggregate)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.aggregate.eer"
        },
        "2": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      },
      "end": "(?<=\\})|(?=^\\s*(?:weak|entity|identifying|rel|specialize|category|partof|aggregate|show)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.eer"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.eer"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#relationship"
            }
          ]
        }
      ]
    },
    "show": {
      "match": "\\b(show)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\"))\\s+(again)\\b(?:\\s+(as)\\s+((?:[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*|\"(?:[^\"\\\\\\n]|\\\\.)*\")))?",
      "captures": {
        "1": {
          "name": "keyword.other.show.eer"
        },
        "2": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        },
        "3": {
          "name": "keyword.other.show.eer"
        },
        "4": {
          "name": "keyword.other.as.eer"
        },
        "5": {
          "patterns": [
            {
              "include": "#entity-name"
            }
          ]
        }
      }
    }
  }
}
