{
  "name": "draw-eer",
  "displayName": "Draw EER",
  "description": "Write ER/EER diagrams as text and see them live in classic Chen notation. Persian (RTL) names supported.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "AmirMOHNasiri",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmirMOHNasiri/draw-eer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "ER diagram",
    "EER",
    "Chen notation",
    "database",
    "Persian"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:drawEer.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "eer",
        "aliases": [
          "EER Diagram",
          "eer"
        ],
        "extensions": [
          ".eer"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/eer-file-light.svg",
          "dark": "./icons/eer-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "eer",
        "scopeName": "source.eer",
        "path": "./syntaxes/eer.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "drawEer.openPreview",
        "title": "Open Preview",
        "category": "Draw EER",
        "icon": "$(open-preview)"
      },
      {
        "command": "drawEer.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Draw EER",
        "icon": "$(open-preview)"
      },
      {
        "command": "drawEer.exportSvg",
        "title": "Export as SVG…",
        "category": "Draw EER"
      },
      {
        "command": "drawEer.exportPng",
        "title": "Export as PNG…",
        "category": "Draw EER"
      },
      {
        "command": "drawEer.resetLayout",
        "title": "Reset Layout",
        "category": "Draw EER"
      },
      {
        "command": "drawEer.undoLayoutChange",
        "title": "Undo Layout Change",
        "category": "Draw EER"
      },
      {
        "command": "drawEer.redoLayoutChange",
        "title": "Redo Layout Change",
        "category": "Draw EER"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "drawEer.openPreviewToSide",
          "when": "editorLangId == eer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "drawEer.openPreview",
          "when": "resourceExtname == .eer",
          "group": "navigation"
        },
        {
          "command": "drawEer.exportSvg",
          "when": "resourceExtname == .eer",
          "group": "7_drawEer@1"
        },
        {
          "command": "drawEer.exportPng",
          "when": "resourceExtname == .eer",
          "group": "7_drawEer@2"
        }
      ],
      "commandPalette": [
        {
          "command": "drawEer.openPreview",
          "when": "editorLangId == eer"
        },
        {
          "command": "drawEer.openPreviewToSide",
          "when": "editorLangId == eer"
        },
        {
          "command": "drawEer.exportSvg",
          "when": "editorLangId == eer || activeWebviewPanelId == 'drawEer.preview'"
        },
        {
          "command": "drawEer.exportPng",
          "when": "editorLangId == eer || activeWebviewPanelId == 'drawEer.preview'"
        },
        {
          "command": "drawEer.resetLayout",
          "when": "editorLangId == eer || activeWebviewPanelId == 'drawEer.preview'"
        },
        {
          "command": "drawEer.undoLayoutChange",
          "when": "activeWebviewPanelId == 'drawEer.preview'"
        },
        {
          "command": "drawEer.redoLayoutChange",
          "when": "activeWebviewPanelId == 'drawEer.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "drawEer.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == eer"
      },
      {
        "command": "drawEer.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == eer"
      },
      {
        "command": "drawEer.undoLayoutChange",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'drawEer.preview'"
      },
      {
        "command": "drawEer.redoLayoutChange",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'drawEer.preview'"
      },
      {
        "command": "drawEer.redoLayoutChange",
        "key": "ctrl+y",
        "when": "activeWebviewPanelId == 'drawEer.preview'"
      }
    ],
    "configuration": {
      "title": "Draw EER",
      "properties": {
        "drawEer.preview.updateDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "How long to wait after typing stops before redrawing the preview, in milliseconds."
        },
        "drawEer.export.pngScale": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Size of exported PNG images, as a multiple of the diagram's size on screen. 3 gives sharp images for print and slides."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.eer.layout.json",
        "url": "./schemas/eer-layout.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "check:webview": "node scripts/build.mjs && node scripts/webview-check.mjs",
    "test:integration": "node scripts/build.mjs && node scripts/integration.mjs"
  },
  "dependencies": {
    "@draw-eer/core": "0.1.0",
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "0.28.2",
    "mocha": "^12.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
