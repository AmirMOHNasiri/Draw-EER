// بیمارستان: انواع صفت، ضعیف، سه‌گانه، بازگشتی، (min,max)

entity بیمار {
  "کد ملی": key
  "شماره پرونده": key2
  نام { کوچک, خانوادگی }
  تلفن: multi
  سن: derived
}

entity پزشک {
  "کد نظام": key
  نام
  تخصص
}

entity بخش {
  کد: key
  نام
}

entity دارو {
  کد: key
  نام
  قیمت
}

weak entity نسخه {
  شماره: partial
  تاریخ
}

weak entity "قلم نسخه" {
  ردیف: partial
  "تعداد مصرف"
}

identifying rel صدور { بیمار 1, نسخه N total }
identifying rel شامل { نسخه 1, "قلم نسخه" N total }
rel "مربوط به" { "قلم نسخه" N total, دارو 1 }

rel ویزیت {
  بیمار M
  پزشک N
  attrs { تاریخ, هزینه }
}

rel عضویت { پزشک N total, بخش 1 }
rel مدیریت { پزشک 1, بخش 1 total }

rel بستری {
  بیمار (0,N)
  بخش (0,M)
  attrs { "تاریخ ورود", "تاریخ خروج" }
}

rel ارجاع {
  پزشک 1 as "ارجاع‌دهنده"
  پزشک N as "ارجاع‌گیرنده"
}

rel تجویز { پزشک, بیمار, دارو }
