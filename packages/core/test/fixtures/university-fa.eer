// دانشگاه: تخصیص، وراثت چندگانه، زیرنوع اجتماع، جزء-کل، تجمیع

entity شخص {
  "کد ملی": key
  نام { کوچک, خانوادگی }
  تلفن: multi
  سن: derived
}

specialize شخص overlapping total { کارمند, دانشجو }
specialize کارمند disjoint partial { استاد, "کارمند اداری" }

entity کارمند { حقوق }
entity دانشجو { "شماره دانشجویی": key2, معدل: derived }
entity استاد { "مرتبه علمی" }
entity "دستیار آموزشی" inherits کارمند, دانشجو { "ساعات کار" }

entity دانشکده { نام: key, بودجه }
rel اشتغال { کارمند N total, دانشکده 1, attrs { "از تاریخ" } }

entity ساختمان { کد: key }
rel استقرار { دانشکده N, ساختمان 1 }
partof ساختمان as دارد { کلاس, آزمایشگاه }
entity کلاس { شماره: key }

entity بانک { "کد بانک": key }
entity شرکت { "کد شرکت": key }
category حامی partial { بانک, شرکت }

entity پروژه { کد: key, عنوان }
rel "تأمین مالی" { پروژه N, حامی 1 }

aggregate راهنمایی { rel "راهنمایی پروژه" { استاد 1, دانشجو N, پروژه } }
entity کمیته { کد: key }
rel ارزیابی { راهنمایی, کمیته, attrs { نمره } }
